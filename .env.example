APP_NAME="Alcor Payroll"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# PostgreSQL: the "postgres" compose service, published on 127.0.0.1:DB_PORT for host-side artisan/PHPUnit.
# Inside compose the PHP containers connect to postgres:5432 (see docker-compose.yml).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54330
DB_DATABASE=alcor_payroll
DB_TEST_DATABASE=alcor_payroll_test
DB_USERNAME=alcor
DB_PASSWORD=secret

# Docker Compose
COMPOSE_PROJECT_NAME=alcor-earning-lines
PHP_VERSION=8.5
POSTGRES_VERSION=18
ADMINER_VERSION=5
ADMINER_PORT=8082
